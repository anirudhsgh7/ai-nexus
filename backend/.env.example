# Copy to .env and adjust. All values below are defaults.

# --- Server ---
AI_NEXUS_HOST=127.0.0.1
AI_NEXUS_PORT=8000

# --- LLM provider ---
AI_NEXUS_OLLAMA_BASE_URL=http://localhost:11434
# Chosen by scripts/benchmark.py decision rule
AI_NEXUS_PRIMARY_MODEL=qwen2.5:14b-instruct
AI_NEXUS_FALLBACK_MODEL=qwen2.5:7b-instruct

# --- Generation limits (always sent explicitly to defeat Ollama's silent 4096 default) ---
AI_NEXUS_NUM_CTX=8192
# Iterative orchestration (Phase 5): critique cycles per run, 1-5
AI_NEXUS_MAX_ROUNDS=3
# How long a loaded model stays resident after last use ("5m", "30m", "-1" = pin)
AI_NEXUS_KEEP_ALIVE=30m
AI_NEXUS_REQUEST_TIMEOUT_S=300
AI_NEXUS_CONNECT_TIMEOUT_S=5
# M4/16GB: keep at 1 (parallel generation is not viable here)
AI_NEXUS_MAX_CONCURRENT_GENERATIONS=1
AI_NEXUS_HEALTH_CACHE_TTL_S=5
# Generation-loop guards (Phase 10): Ollama's own defaults; raise PENALTY
# (e.g. 1.2) if a run dies with "token repeat limit reached".
AI_NEXUS_REPEAT_PENALTY=1.1
AI_NEXUS_REPEAT_LAST_N=64

# --- Logging ---
AI_NEXUS_LOG_LEVEL=INFO
AI_NEXUS_LOG_TOKEN_USAGE=true

# --- Defaults ---
AI_NEXUS_DEFAULT_TEMPERATURE=0.0
# JSON list
AI_NEXUS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Tools (Phase 6) ---
# Max tool executions per agent call (1-10). One LLM turn per execution.
AI_NEXUS_TOOL_MAX_STEPS=5
# Per-tool-call timeout in seconds
AI_NEXUS_TOOL_TIMEOUT_S=20
# Hard cap on chars of any single tool result fed back to the model
AI_NEXUS_TOOL_RESULT_MAX_CHARS=2000
# Cumulative char budget across one agent call (must be >= RESULT_MAX_CHARS)
AI_NEXUS_TOOL_RESULTS_BUDGET_CHARS=6000
# Directory agents may read from (file_search/file_reader). Empty = file tools disabled.
AI_NEXUS_TOOL_FILES_ROOT=
# Free keyless web_search backend. Default on (set false for fully offline runs).
AI_NEXUS_TOOL_WEB_SEARCH_ENABLED=true
AI_NEXUS_TOOL_WEB_SEARCH_MAX_RESULTS=5
# --- Web search reliability (Phase 8b) ---
# Provider cascade order; each must be one of: ddg, bing.
# DDG is primary (browser-faithful POST + retries); Bing is the fallback.
AI_NEXUS_TOOL_WEB_SEARCH_PROVIDERS=["ddg","bing"]
# Global minimum seconds between provider calls (0.5-30) with up to 20% jitter.
AI_NEXUS_TOOL_WEB_SEARCH_MIN_INTERVAL_S=3.0
# Retries per provider on challenge/empty responses (0-5); never on network errors.
AI_NEXUS_TOOL_WEB_SEARCH_RETRIES=2
# Exponential backoff base in seconds (0.5-15) for challenge retries.
AI_NEXUS_TOOL_WEB_SEARCH_BACKOFF_BASE_S=2.0
# Whole-call budget for web_search only (5-120); other tools keep TOOL_TIMEOUT_S.
AI_NEXUS_TOOL_WEB_SEARCH_TIMEOUT_S=45
# Success cache TTL in seconds (0 = disabled; max 86400). Blocks are never cached.
AI_NEXUS_TOOL_WEB_SEARCH_CACHE_TTL_S=900
# DDG region form field.
AI_NEXUS_TOOL_WEB_SEARCH_REGION=us-en

# --- Persistence (Phase 7) ---
# SQLite file, relative to the process CWD. Empty = no persistence (Phase 6 behavior).
AI_NEXUS_DB_PATH=data/ai_nexus.db
# Newest N finished runs kept in the DB (0 = unlimited). Running runs are never pruned.
AI_NEXUS_DB_RETENTION_RUNS=500

# --- Shutdown (Phase 10) ---
# Seconds scripts/serve.py lets uvicorn wait for open connections (SSE) before
# force-closing them on SIGTERM/SIGINT. Bounds how long a restart can be delayed.
AI_NEXUS_SHUTDOWN_GRACE_S=5
