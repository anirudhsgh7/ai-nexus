# Backend base URL for the API and SSE stream (no trailing slash).
# Default (when unset): http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000

# Notes:
# - The backend CORS allow-list defaults to http://localhost:5173 and
#   http://127.0.0.1:5173. `npm run dev` / `npm run preview` run on 5173
#   (strictPort) to match. Any other port requires AI_NEXUS_CORS_ORIGINS
#   on the backend, e.g. AI_NEXUS_CORS_ORIGINS='["http://localhost:4173"]'.
# - Start the backend from backend/ with:
#     .venv/bin/uvicorn app.main:app --port 8000
